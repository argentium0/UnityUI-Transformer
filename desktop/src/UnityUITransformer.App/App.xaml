<Application x:Class="UnityUITransformer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnityUITransformer.App"
             xmlns:converters="clr-namespace:UnityUITransformer.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
            <converters:StringNullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisConverter"/>
            <converters:StepActiveToOpacityConverter x:Key="StepOpacityConverter"/>
            <converters:StepActiveToBorderBrushConverter x:Key="StepBorderBrushConverter"/>
            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter"/>

            <!-- Pro Max Design System Palette -->
            <Color x:Key="ColorBgDeep">#09090B</Color>          <!-- Zinc-950 Base Canvas -->
            <Color x:Key="ColorBgCard">#121216</Color>          <!-- Elevated Card Panel -->
            <Color x:Key="ColorBgHeader">#141419</Color>        <!-- Header / Subpanel -->
            <Color x:Key="ColorBgFloating">#18181B</Color>      <!-- Floating Controls -->
            <Color x:Key="ColorBgInput">#0E0E12</Color>         <!-- Deep Inset Input -->
            <Color x:Key="ColorTerminal">#050505</Color>        <!-- Ultra-dark Debug Terminal -->

            <Color x:Key="ColorBorderSubtle">#27272A</Color>    <!-- Zinc-800 Crisp Glass Border -->
            <Color x:Key="ColorBorderHover">#3F3F46</Color>     <!-- Zinc-700 Hover Border -->
            <Color x:Key="ColorBorderFocus">#8B5CF6</Color>     <!-- Violet Focus Ring -->

            <!-- Accents -->
            <Color x:Key="ColorAccentIndigo">#6366F1</Color>
            <Color x:Key="ColorAccentViolet">#8B5CF6</Color>
            <Color x:Key="ColorAccentCyan">#38BDF8</Color>
            <Color x:Key="ColorSuccessEmerald">#34D399</Color>
            <Color x:Key="ColorWarningAmber">#FBBF24</Color>
            <Color x:Key="ColorErrorCoral">#F87171</Color>

            <Color x:Key="ColorTextPrimary">#F4F4F5</Color>
            <Color x:Key="ColorTextSecondary">#A1A1AA</Color>
            <Color x:Key="ColorTextMuted">#71717A</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BrushBgDeep" Color="{StaticResource ColorBgDeep}"/>
            <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
            <SolidColorBrush x:Key="BrushBgHeader" Color="{StaticResource ColorBgHeader}"/>
            <SolidColorBrush x:Key="BrushBgFloating" Color="{StaticResource ColorBgFloating}"/>
            <SolidColorBrush x:Key="BrushBgInput" Color="{StaticResource ColorBgInput}"/>
            <SolidColorBrush x:Key="BrushTerminal" Color="{StaticResource ColorTerminal}"/>

            <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>
            <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}"/>
            <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource ColorBorderFocus}"/>

            <!-- Primary Accent Gradient Brush (Indigo -> Violet) -->
            <LinearGradientBrush x:Key="BrushGradientPrimary" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#6366F1" Offset="0.0"/>
                <GradientStop Color="#8B5CF6" Offset="1.0"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="BrushGradientPrimaryHover" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#4F46E5" Offset="0.0"/>
                <GradientStop Color="#7C3AED" Offset="1.0"/>
            </LinearGradientBrush>

            <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}"/>
            <SolidColorBrush x:Key="BrushSuccessEmerald" Color="{StaticResource ColorSuccessEmerald}"/>
            <SolidColorBrush x:Key="BrushWarningAmber" Color="{StaticResource ColorWarningAmber}"/>
            <SolidColorBrush x:Key="BrushErrorCoral" Color="{StaticResource ColorErrorCoral}"/>

            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
            <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>

            <!-- Pro Max Primary Button Style -->
            <Style x:Key="ProMaxPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushGradientPrimary}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="20,11"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="8" 
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#8B5CF6" BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BrushGradientPrimaryHover}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="1" Opacity="0.55"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#18181B"/>
                                    <Setter Property="Foreground" Value="#52525B"/>
                                    <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pro Max Secondary Button Style -->
            <Style x:Key="ProMaxSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource BrushBgFloating}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#09090B"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pro Max Monospace TextBox Style -->
            <Style x:Key="ProMaxTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource BrushBgInput}"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New, monospace"/>
                <Setter Property="CaretBrush" Value="{StaticResource BrushAccentCyan}"/>
                <Setter Property="SelectionBrush" Value="#6366F1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderFocus}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorderHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Pro Max CheckBox Style -->
            <Style x:Key="ProMaxCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="border" Width="14" Height="14" CornerRadius="3" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,6,0">
                                    <TextBlock x:Name="checkMark" Text="✓" Foreground="#34D399" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#064E3B"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#10B981"/>
                                    <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Custom ScrollBar Styling for Terminal -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                    <Track.Thumb>
                                        <Thumb x:Name="thumb">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#27272A" CornerRadius="4"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
