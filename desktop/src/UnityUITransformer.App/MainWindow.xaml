<Window x:Class="UnityUITransformer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnityUITransformer.App"
        xmlns:vm="clr-namespace:UnityUITransformer.App.ViewModels"
        mc:Ignorable="d"
        Title="Figma → Unity UI Transformer (Pro Max Edition)" 
        Height="820" Width="1060"
        MinWidth="940" MinHeight="680"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, System-UI, sans-serif"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Glass App Header -->
            <RowDefinition Height="*"/>    <!-- Pro Max Wizard Steps & Debug Console -->
        </Grid.RowDefinitions>

        <!-- ================= TOP GLASS APP HEADER ================= -->
        <Border Grid.Row="0" 
                Background="{StaticResource BrushBgCard}" 
                BorderBrush="{StaticResource BrushBorderSubtle}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="24,18" 
                Margin="0,0,0,24">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource BrushGradientPrimary}" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="1" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="F2U" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Figma → Unity UI Transformer" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Bold" FontSize="18"/>
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VersionTag}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Commercial-Grade Design Token &amp; VisualTree Pipeline Engine" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Connection Status Indicator Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Disconnected State Pill -->
                    <Border Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"
                            Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="20" Padding="14,7">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BrushWarningAmber}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Connected State Pill -->
                    <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                            Background="#022C22" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="16,7">
                        <Border.Effect>
                            <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" Foreground="#34D399" FontWeight="Bold" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#ECFDF5" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN WIZARD BODY ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- STEP 1 CARD (Authentication) -->
                <Border Background="{StaticResource BrushBgCard}" 
                        BorderBrush="{Binding IsStep1Completed, Converter={StaticResource StepBorderBrushConverter}}" 
                        BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Step 1 Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrushGradientPrimary}" Margin="0,0,12,0">
                                    <TextBlock Text="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Step 1: Authenticate Figma Service" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}" 
                                    Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="✓ Authenticated" Foreground="#34D399" FontWeight="SemiBold" FontSize="11.5"/>
                            </Border>
                        </Grid>

                        <!-- Step 1 Content -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Authenticate via OAuth 2.0 or Personal Access Token to extract design tokens, auto-layout variables, and node trees." 
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="20"/>

                            <!-- Connect Action -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Button Command="{Binding ConnectCommand}" 
                                        Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"
                                        Padding="22,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Connect with Figma" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                                        Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="16,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Token Active" Foreground="#A1A1AA" FontWeight="Medium" FontSize="12.5" Margin="0,0,8,0"/>
                                        <TextBlock Text="🔑" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- STEP 2 CARD (Configuration & Target Paths) -->
                <Border Background="{StaticResource BrushBgCard}" 
                        BorderBrush="{Binding IsStep2Active, Converter={StaticResource StepBorderBrushConverter}}" 
                        Opacity="{Binding IsStep2Active, Converter={StaticResource StepOpacityConverter}}"
                        BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Step 2 Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrushGradientPrimary}" Margin="0,0,12,0">
                                    <TextBlock Text="2" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Step 2: Source Document &amp; Target Paths" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>

                            <Border Visibility="{Binding IsStep2Completed, Converter={StaticResource BoolToVisConverter}}" 
                                    Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="✓ Configuration Valid" Foreground="#34D399" FontWeight="SemiBold" FontSize="11.5"/>
                            </Border>
                        </Grid>

                        <!-- Row 1: Figma File / Node URL -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Figma File / Node URL" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" FontSize="13"/>
                                <TextBlock Text="✓ URL Verified" Foreground="{StaticResource BrushSuccessEmerald}" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Right"
                                           Visibility="{Binding IsFigmaUrlValid, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                            <Grid>
                                <TextBox Text="{Binding FigmaUrl, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsStep2Active}"
                                         Style="{StaticResource ProMaxTextBoxStyle}"/>
                                <TextBlock Text="https://www.figma.com/file/XYZ123456/App-UI-Kit?node-id=1:2" 
                                           Foreground="{StaticResource BrushTextMuted}" 
                                           FontSize="12.5" FontFamily="Cascadia Code, Consolas" Margin="14,11" IsHitTestVisible="False"
                                           Visibility="{Binding FigmaUrl, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Row 2: Unity Target Directory -->
                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Unity Target Assets Directory" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" FontSize="13"/>
                                <TextBlock Text="✓ Target Selected" Foreground="{StaticResource BrushSuccessEmerald}" FontSize="11.5" FontWeight="Medium" HorizontalAlignment="Right"
                                           Visibility="{Binding IsUnityPathValid, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding UnityAssetsPath, UpdateSourceTrigger=PropertyChanged}" 
                                             IsEnabled="{Binding IsStep2Active}"
                                             Style="{StaticResource ProMaxTextBoxStyle}"/>
                                    <TextBlock Text="C:\Projects\MyUnityGame\Assets\UI" 
                                               Foreground="{StaticResource BrushTextMuted}" 
                                               FontSize="12.5" FontFamily="Cascadia Code, Consolas" Margin="14,11" IsHitTestVisible="False"
                                               Visibility="{Binding UnityAssetsPath, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                                </Grid>

                                <Button Grid.Column="1" 
                                        Command="{Binding BrowseFolderCommand}" 
                                        Content="Browse..." 
                                        Style="{StaticResource ProMaxSecondaryButtonStyle}" 
                                        Margin="12,0,0,0" Padding="18,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- STEP 3 CARD (Transformation & IDE Debug Terminal) -->
                <Border Background="{StaticResource BrushBgCard}" 
                        BorderBrush="{Binding IsStep3Active, Converter={StaticResource StepBorderBrushConverter}}" 
                        Opacity="{Binding IsStep3Active, Converter={StaticResource StepOpacityConverter}}"
                        BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Step 3 Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrushGradientPrimary}" Margin="0,0,12,0">
                                    <TextBlock Text="3" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Step 3: Execute Translation Engine" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="15"/>
                            </StackPanel>
                        </Grid>

                        <!-- Primary Action & Progress -->
                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Compile design hierarchy into native UI Toolkit UXML visual trees, USS stylesheets, and design token ScriptableObjects." 
                                           Foreground="{StaticResource BrushTextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>

                                <!-- Progress Bar during Sync -->
                                <StackPanel Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}" Margin="0,14,0,0">
                                    <ProgressBar Height="6" Value="{Binding SyncProgress}" Maximum="100" Background="#0E0E12" Foreground="{StaticResource BrushGradientPrimary}" BorderThickness="0"/>
                                    <TextBlock Text="{Binding SyncStatusText}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                    Command="{Binding SyncCommand}" 
                                    Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                                    Padding="28,14" Margin="20,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ Sync UI to Unity" FontWeight="Bold" FontSize="14.5"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Terminal Header Bar -->
                        <Border Grid.Row="2" Background="{StaticResource BrushBgHeader}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="16,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccessEmerald}" Margin="0,0,8,0"/>
                                    <TextBlock Text="IDE Debug Console" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12.5"/>
                                    <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0">
                                        <TextBlock Text="ShimLogSink" Foreground="{StaticResource BrushAccentCyan}" FontSize="10.5" FontFamily="Cascadia Code, Consolas"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding AutoScrollEnabled}" Style="{StaticResource ProMaxCheckBoxStyle}" Content="Auto-Scroll" Margin="0,0,16,0"/>
                                    <Button Command="{Binding ClearLogsCommand}" Content="Clear Console" Style="{StaticResource ProMaxSecondaryButtonStyle}" Padding="12,5" FontSize="11" Margin="0,0,10,0"/>
                                    <Button Command="{Binding ToggleTerminalCommand}" Content="{Binding TerminalToggleText}" Style="{StaticResource ProMaxSecondaryButtonStyle}" Padding="12,5" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Pro Max Terminal Output Console -->
                        <Border Grid.Row="3" 
                                Visibility="{Binding IsTerminalExpanded, Converter={StaticResource BoolToVisConverter}}"
                                Background="{StaticResource BrushTerminal}" 
                                BorderBrush="{StaticResource BrushBorderSubtle}" 
                                BorderThickness="1,0,1,1" 
                                CornerRadius="0,0,10,10" 
                                Height="200" 
                                Padding="14">
                            <ScrollViewer x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}" Foreground="{StaticResource BrushTextMuted}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='[{0}]'}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
