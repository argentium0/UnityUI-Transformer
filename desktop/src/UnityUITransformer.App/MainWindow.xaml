<Window x:Class="UnityUITransformer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnityUITransformer.App"
        xmlns:vm="clr-namespace:UnityUITransformer.App.ViewModels"
        xmlns:views="clr-namespace:UnityUITransformer.App.Views"
        mc:Ignorable="d"
        Title="UnityUI Transformer" 
        Width="980" Height="660"
        MinWidth="850" MinHeight="550"
        FontFamily="Segoe UI Variable, Inter, sans-serif"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- DataTemplate Mappings for MVVM 3-Screen Navigation -->
        <DataTemplate DataType="{x:Type vm:AuthViewModel}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
        <BitmapImage x:Key="DefaultAvatar" UriSource="pack://application:,,,/Assets/figma_avatar.png" />
    </Window.Resources>

    <!-- 2-COLUMN DRIBBBLE DASHBOARD GRID (COLUMN 0: 90PX CIRCULAR NAVIGATION | COLUMN 1: WORKSPACE) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/> <!-- Sleek 90px Circular Icon Navigation Sidebar -->
            <ColumnDefinition Width="*"/>  <!-- Main Viewport Content -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. COLUMN 0: CIRCULAR ICON SIDEBAR (90PX) ================= -->
        <Border Grid.Column="0" 
                Background="#18181A" 
                BorderBrush="#25262B" 
                BorderThickness="0,0,1,0">
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top App Logo Badge -->
                    <RowDefinition Height="*"/>    <!-- Stacked High-Contrast Circular Step Vector Icon Buttons -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Global Info & Settings Stack -->
                </Grid.RowDefinitions>

                <!-- Top App Logo Icon Badge -->
                <Border Grid.Row="0" Width="44" Height="44" CornerRadius="22" Background="#18181A" BorderBrush="#D4FF32" BorderThickness="1.5" HorizontalAlignment="Center">
                    <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z" Stroke="#D4FF32" StrokeThickness="1.8" Fill="#1F2414"/>
                            <Path Data="M12,2 L12,12 L21,7 M12,12 L3,7 M12,12 L12,22" Stroke="#D4FF32" StrokeThickness="1.5"/>
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#D4FF32"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <!-- Stacked 48x48 Circular Step Vector Icon Buttons -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    
                    <!-- STEP 1: AUTHENTICATION (Lock Icon) -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="1" 
                            ToolTip="1. Authentication"
                            Margin="0,0,0,22" HorizontalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12 2C9.24 2 7 4.24 7 7v3H6c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-8c0-1.1-.9-2-2-2h-1V7c0-2.76-2.24-5-5-5zm-3 5c0-1.66 1.34-3 3-3s3 1.34 3 3v3H9V7zm3 10c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1}" Value="True">
                                                <Setter Property="Fill" Value="#000000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- STEP 2: TARGET CONFIGURATION (Folder Icon) -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="2" 
                            ToolTip="2. Target Configuration"
                            Margin="0,0,0,22" HorizontalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2}" Value="True">
                                                <Setter Property="Fill" Value="#000000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- STEP 3: SYNC PIPELINE (Lightning Bolt Icon) -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="3" 
                            ToolTip="3. Sync Pipeline"
                            HorizontalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M7 2v11h3v9l7-12h-4l4-8H7z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3}" Value="True">
                                                <Setter Property="Fill" Value="#000000"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Viewbox>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Bottom Sidebar Stack: Consolidated Global Info Toggle Button + Settings Button -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
                    
                    <!-- Single Consolidated Circular Info 'i' Button -->
                    <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                        <ToggleButton x:Name="GlobalInfoToggle" 
                                      Width="36" Height="36" 
                                      Style="{StaticResource InfoToggleButtonStyle}"
                                      ToolTip="View Step Instructions"/>

                        <!-- Context-Aware Dynamic Instructions Popup -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=GlobalInfoToggle}" Placement="Right" AllowsTransparency="True" StaysOpen="False" HorizontalOffset="14">
                            <Border Background="#25262B" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="16" MaxWidth="280">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Step 1 Instructions (Auth) -->
                                    <StackPanel x:Name="Step1InfoText">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 1: Authentication" Foreground="#D4FF32" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Click 'Connect with Figma' to open your browser. Log into your Figma account and authorize the application to generate a secure OAuth session token." Foreground="#E0E0E0" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>

                                    <!-- Step 2 Instructions (Config) -->
                                    <StackPanel x:Name="Step2InfoText">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 2: Target Configuration" Foreground="#D4FF32" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Paste the full URL of your Figma design file. Then, select the exact local directory in your Unity project where the UI assets should be generated." Foreground="#E0E0E0" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>

                                    <!-- Step 3 Instructions (Sync) -->
                                    <StackPanel x:Name="Step3InfoText">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Step 3: Sync Pipeline" Foreground="#D4FF32" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Execute the transformation. The pipeline will parse your Figma nodes and convert them into Unity UXML and USS files. Monitor the terminal below for live logs." Foreground="#E0E0E0" FontSize="12" TextWrapping="Wrap" LineHeight="17"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Circular Settings Button -->
                    <Button Width="40" Height="40" 
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Settings &amp; Preferences"
                            HorizontalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Setter Property="Width" Value="40"/>
                                <Setter Property="Height" Value="40"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. COLUMN 1: MAIN VIEWPORT CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Compact Workspace Header Bar -->
                <RowDefinition Height="*"/>    <!-- Active Screen Viewport -->
            </Grid.RowDefinitions>

            <!-- Top Compact Workspace Header -->
            <Border Grid.Row="0" Background="#18181A" Padding="28,16,28,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UnityUI Transformer" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Connection Status Badge & User Profile Header -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Disconnected Status Pill -->
                        <Border Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"
                                Background="#1F2024" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#9E9E9E" FontSize="11.5" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Connected Status Pill -->
                        <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                                Background="#192A20" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Header User Name & Live Avatar -->
                        <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}" 
                                    Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock Text="{Binding ConnectedUser}" Foreground="#E0E0E0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Width="32" Height="32" CornerRadius="16" BorderBrush="#D4FF32" BorderThickness="1.5" VerticalAlignment="Center" ToolTip="{Binding ConnectedUser}">
                                <Ellipse Width="29" Height="29">
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding UserAvatarSource, FallbackValue={StaticResource DefaultAvatar}, TargetNullValue={StaticResource DefaultAvatar}}" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area Hosting Active Screen -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False"/>
        </Grid>

        <!-- ================= 3. SETTINGS MODAL OVERLAY ================= -->
        <Grid Grid.ColumnSpan="2" 
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisConverter}}" 
              Background="#99000000" 
              Panel.ZIndex="999">
            <views:SettingsView HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
