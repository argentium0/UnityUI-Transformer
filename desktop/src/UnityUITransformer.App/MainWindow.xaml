<Window x:Class="UnityUITransformer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UnityUITransformer.App"
        xmlns:vm="clr-namespace:UnityUITransformer.App.ViewModels"
        xmlns:views="clr-namespace:UnityUITransformer.App.Views"
        mc:Ignorable="d"
        Title="UnityUI Transformer" 
        Width="980" Height="660"
        MinWidth="850" MinHeight="550"
        FontFamily="Segoe UI Variable, Inter, sans-serif"
        Background="{StaticResource BrushBgDeep}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- DataTemplate Mappings for MVVM 3-Screen Navigation -->
        <DataTemplate DataType="{x:Type vm:AuthViewModel}">
            <views:AuthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigViewModel}">
            <views:ConfigView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SyncViewModel}">
            <views:SyncView />
        </DataTemplate>
    </Window.Resources>

    <!-- 2-COLUMN DRIBBBLE DASHBOARD GRID (COLUMN 0: 240PX NAVIGATION RAIL | COLUMN 1: WORKSPACE) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/> <!-- Expanded High-Contrast Navigation Rail -->
            <ColumnDefinition Width="*"/>   <!-- Main Viewport Content -->
        </Grid.ColumnDefinitions>

        <!-- ================= 1. COLUMN 0: EXPANDED NAVIGATION RAIL (240PX) ================= -->
        <Border Grid.Column="0" 
                Background="#121215" 
                BorderBrush="#25262B" 
                BorderThickness="0,0,1,0">
            <Grid Margin="0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Logo & App Title Block -->
                    <RowDefinition Height="*"/>    <!-- Stacked High-Contrast Step Rail Buttons -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Connection Status Badge -->
                </Grid.RowDefinitions>

                <!-- Top Logo Icon & App Title Block -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,4,20,0" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#18181A" BorderBrush="#D4FF32" BorderThickness="1.5" Margin="0,0,12,0">
                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z" Stroke="#D4FF32" StrokeThickness="1.8" Fill="#1F2414"/>
                                <Path Data="M12,2 L12,12 L21,7 M12,12 L3,7 M12,12 L12,22" Stroke="#D4FF32" StrokeThickness="1.5"/>
                                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="4" Height="4" Fill="#D4FF32"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="UnityUI" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Transformer" Foreground="#9E9E9E" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Stacked High-Contrast Navigation Rail Buttons -->
                <StackPanel Grid.Row="1" Margin="16,32,16,0" VerticalAlignment="Top">
                    <!-- Step 1 Button: Authentication -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="1" 
                            ToolTip="1. Authentication"
                            Margin="0,0,0,10" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="01" FontWeight="Bold" FontSize="13" Margin="0,0,14,0"/>
                            <TextBlock Text="Authentication" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarRailButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=1}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#D4FF32" BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Step 2 Button: Target Config -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="2" 
                            ToolTip="2. Target Configuration"
                            Margin="0,0,0,10" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="02" FontWeight="Bold" FontSize="13" Margin="0,0,14,0"/>
                            <TextBlock Text="Target Config" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarRailButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=2}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#D4FF32" BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Step 3 Button: Sync Pipeline -->
                    <Button Command="{Binding NavigateToStepCommand}" CommandParameter="3" 
                            ToolTip="3. Sync Pipeline"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="03" FontWeight="Bold" FontSize="13" Margin="0,0,14,0"/>
                            <TextBlock Text="Sync Pipeline" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarRailButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStepIndex, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=3}" Value="True">
                                        <Setter Property="Background" Value="#D4FF32"/>
                                        <Setter Property="Foreground" Value="#000000"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#D4FF32" BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Bottom Sidebar Connection Status Badge -->
                <Border Grid.Row="2" Margin="16,0,16,0" Background="#18181C" BorderBrush="#25262B" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,10,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1.0" Duration="0:0:1.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#9E9E9E" FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2. COLUMN 1: MAIN VIEWPORT CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Compact Workspace Header Bar -->
                <RowDefinition Height="*"/>    <!-- Active Screen Viewport -->
            </Grid.RowDefinitions>

            <!-- Top Compact Workspace Header -->
            <Border Grid.Row="0" Background="#18181A" Padding="28,16,28,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UnityUI Transformer" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Connection Status Badge & User Avatar -->
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Disconnected Status Pill -->
                        <Border Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"
                                Background="#1F2024" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#9E9E9E" FontSize="11.5" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <!-- Connected Status Pill -->
                        <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                                Background="#192A20" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="12,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatusText}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Circular User Avatar with Neon Accent Mask -->
                        <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}" 
                                Margin="10,0,0,0" Width="30" Height="30" CornerRadius="15" BorderBrush="#D4FF32" BorderThickness="1.5" VerticalAlignment="Center">
                            <Ellipse Width="27" Height="27">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area Hosting Active Screen -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
