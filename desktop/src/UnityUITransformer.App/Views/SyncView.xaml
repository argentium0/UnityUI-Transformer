<UserControl x:Class="UnityUITransformer.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- Fluid Screen Loaded Storyboard: Smooth 0.4s Fade-In & Slide-Up from Y=20 -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="20"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Header Card -->
            <RowDefinition Height="*"/>    <!-- Terminal & Completion Feedback Area -->
            <RowDefinition Height="Auto"/> <!-- Post-Sync Completion Actions -->
        </Grid.RowDefinitions>

        <!-- TOP ACTION CARD (Execute Sync Engine) -->
        <Border Grid.Row="0" 
                Background="#25262B" 
                CornerRadius="20" 
                Padding="28,22" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Card Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#D4FF32" Margin="0,0,12,0">
                            <TextBlock Text="3" Foreground="#18181A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Execute Translation Engine" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>

                    <!-- Active Status Pill -->
                    <Border Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}"
                            Background="#1F2414" BorderBrush="#D4FF32" BorderThickness="1" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Transformation Active" Foreground="#D4FF32" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </Grid>

                <!-- Action & Progress Region -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Compile design hierarchy into native UI Toolkit UXML visual trees &amp; USS stylesheets." 
                                   Foreground="#9E9E9E" FontSize="12.5" TextWrapping="Wrap"/>

                        <!-- Active Progress Bar during Sync -->
                        <StackPanel Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}" Margin="0,12,0,0">
                            <ProgressBar Height="5" Value="{Binding SyncProgress, Mode=OneWay}" Maximum="100" Background="#1F2024" Foreground="#D4FF32" BorderThickness="0"/>
                            <TextBlock Text="{Binding SyncStatusText}" Foreground="#D4FF32" FontSize="11.5" FontFamily="Cascadia Code, Consolas" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sync Trigger Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding SyncCommand}" 
                            Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                            ToolTip="Run transformation pipeline and emit visual assets into target Unity directory"
                            Padding="24,12" Margin="20,0,0,0">
                        <Grid>
                            <!-- Idle State -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="⚡ Run Transformation" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>

                            <!-- Active Loading State -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="⏳ Syncing Pipeline..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- CENTRAL AREA: COMPLETION FEEDBACK BANNER & TERMINAL CONSOLE -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Completion Feedback Banner -->
                <RowDefinition Height="*"/>    <!-- Monospace Terminal Window -->
            </Grid.RowDefinitions>

            <!-- PROMINENT TRANSFORMATION COMPLETE FEEDBACK CARD -->
            <Border Grid.Row="0"
                    Visibility="{Binding IsSyncComplete, Converter={StaticResource BoolToVisConverter}}"
                    Background="#192A1F" BorderBrush="#D4FF32" BorderThickness="1.5" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Success Badge -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#D4FF32" Margin="0,0,14,0">
                        <TextBlock Text="✓" Foreground="#18181A" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Feedback Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Transformation Complete!" Foreground="#D4FF32" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="UXML layout skeleton &amp; USS stylesheets exported to your Unity target directory." Foreground="#E5E7EB" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DEEP BLACK MONOSPACE TERMINAL CONSOLE (#0D0D0F, CornerRadius=12, Border=#333333) -->
            <Border Grid.Row="1" 
                    Background="#0D0D0F" 
                    BorderBrush="#333333" 
                    BorderThickness="1" 
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Console Bar -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Monospace Logs -->
                    </Grid.RowDefinitions>

                    <!-- Terminal Header Bar -->
                    <Border Grid.Row="0" Background="#141417" BorderBrush="#25262B" BorderThickness="0,0,0,1" Padding="16,10" CornerRadius="12,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#D4FF32" Margin="0,0,8,0"/>
                                <TextBlock Text="Live Output Console" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding ClearLogsCommand}" Content="Clear Terminal" ToolTip="Clear terminal logs" Style="{StaticResource ProMaxSecondaryButtonStyle}" Padding="12,4" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Monospace Log Stream ScrollViewer -->
                    <ScrollViewer Grid.Row="1" x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Monospace Timestamp -->
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp, StringFormat='[{0}] '}" Foreground="#55555C" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11.5" Margin="0,0,6,0"/>

                                        <!-- Monospace Log Message with Color Syntax -->
                                        <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Cascadia Code, Consolas, Courier New" FontSize="11.5" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A0A0A5"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- POST-SYNC COMPLETION ACTIONS BAR -->
        <Border Grid.Row="2" Margin="0,16,0,0" Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                
                <!-- BUTTON 1: Open Target Folder (Secondary Dark Gray #25262B with White Text) -->
                <Button Command="{Binding OpenFolderCommand}" 
                        Content="📁 Open Target Folder" 
                        ToolTip="Open local directory in Windows File Explorer"
                        Style="{StaticResource ProMaxSecondaryButtonStyle}" 
                        Padding="20,10" FontSize="13" Margin="0,0,12,0"/>

                <!-- BUTTON 2: Return to Config (Primary Neon Lime Green #D4FF32 with Black Text) -->
                <Button Command="{Binding ResetCommand}" 
                        Content="↺ Return to Config" 
                        ToolTip="Reset pipeline state and return to Step 2 Target Configuration"
                        Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                        Padding="22,10" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
