<UserControl x:Class="UnityUITransformer.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <!-- Fluid Screen Loaded Storyboard: Smooth 0.4s Fade-In & Slide-Up from Y=20 -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="20"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Card -->
            <RowDefinition Height="*"/>    <!-- Expanded Dark Terminal Console Block -->
        </Grid.RowDefinitions>

        <!-- TOP ACTION CARD (Execute Sync Engine) -->
        <Border Grid.Row="0" 
                Background="#25262B" 
                CornerRadius="24" 
                Padding="32,28" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Card Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#D4FF32" Margin="0,0,12,0">
                            <TextBlock Text="3" Foreground="#18181A" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Execute Translation Engine" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                </Grid>

                <!-- Action & Progress Region -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Compile design hierarchy into native UI Toolkit UXML visual trees, USS stylesheets, and design token ScriptableObjects." 
                                   Foreground="#9E9E9E" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>

                        <!-- Active Progress Bar during Sync -->
                        <StackPanel Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}" Margin="0,16,0,0">
                            <ProgressBar Height="6" Value="{Binding SyncProgress}" Maximum="100" Background="#1F2024" Foreground="#D4FF32" BorderThickness="0"/>
                            <TextBlock Text="{Binding SyncStatusText}" Foreground="#D4FF32" FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sync Trigger Button -->
                    <Button Grid.Column="1" 
                            Command="{Binding SyncCommand}" 
                            Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                            ToolTip="Run transformation pipeline and emit visual assets into target Unity directory"
                            Padding="28,14" Margin="24,0,0,0">
                        <Grid>
                            <!-- Idle State -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisConverter}}">
                                <TextBlock Text="⚡ Sync UI to Unity" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>

                            <!-- Active Loading State -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="⏳ Syncing Pipeline..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- PITCH CHARCOAL TERMINAL CONSOLE BLOCK -->
        <Border Grid.Row="1" 
                Background="#141416" 
                CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Console Toolbar -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Log Stream -->
                </Grid.RowDefinitions>

                <!-- Terminal Action Bar -->
                <Border Grid.Row="0" Background="#18181C" BorderBrush="#25262B" BorderThickness="0,0,0,1" Padding="18,12" CornerRadius="16,16,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,10,0"/>
                            <TextBlock Text="System Log Stream" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                            <Border Background="#1F2024" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="12,0,0,0">
                                <TextBlock Text="ShimLogSink" Foreground="#D4FF32" FontSize="10.5" FontFamily="Cascadia Code, Consolas"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding AutoScrollEnabled}" Style="{StaticResource ProMaxCheckBoxStyle}" Content="Auto-Scroll" ToolTip="Automatically scroll to latest log events" Margin="0,0,16,0"/>
                            <Button Command="{Binding ClearLogsCommand}" Content="Clear Logs" ToolTip="Clear terminal console entries" Style="{StaticResource ProMaxSecondaryButtonStyle}" Padding="14,6" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log Stream ScrollViewer -->
                <ScrollViewer Grid.Row="1" x:Name="TerminalScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp, StringFormat='[{0}]'}" Foreground="#6E6E6E" FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='[{0}]'}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
