<UserControl x:Class="UnityUITransformer.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <!-- Fluid Screen Loaded Storyboard: Smooth 0.4s Fade-In & Slide-Up from Y=20 -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="20"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Elevated Charcoal Card Panel (CornerRadius=24, Flat, No Shadow) -->
        <Border Background="#25262B" 
                CornerRadius="24" 
                Padding="40,36" MaxWidth="680" Width="680">

            <StackPanel>
                <!-- Screen Header & Title -->
                <Grid Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#D4FF32" Margin="0,0,14,0">
                            <TextBlock Text="2" Foreground="#18181A" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Target Configuration" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="Configure Figma source document and Unity target folder" Foreground="#9E9E9E" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Visibility="{Binding IsStep2Completed, Converter={StaticResource BoolToVisConverter}}" 
                            Background="#192A20" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="✓ Ready for Sync" Foreground="#10B981" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>

                <Separator Background="#2D2E34" Margin="0,0,0,24"/>

                <!-- Input 1: Figma File URL -->
                <StackPanel Margin="0,0,0,22">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Figma File / Node URL" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="✓ URL Verified" Foreground="#D4FF32" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Visibility="{Binding IsFigmaUrlValid, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                    <Grid>
                        <TextBox Text="{Binding FigmaUrl, UpdateSourceTrigger=PropertyChanged}" 
                                 ToolTip="Paste full Figma document URL or specific node URL"
                                 Style="{StaticResource ProMaxTextBoxStyle}"/>
                        <TextBlock Text="https://www.figma.com/file/XYZ123456/App-UI-Kit?node-id=1:2" 
                                   Foreground="#6E6E6E" 
                                   FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="16,12" IsHitTestVisible="False"
                                   Visibility="{Binding FigmaUrl, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                    </Grid>
                </StackPanel>

                <!-- Input 2: Unity Assets Directory -->
                <StackPanel Margin="0,0,0,32">
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Unity Target Assets Directory" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="✓ Directory Selected" Foreground="#D4FF32" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                   Visibility="{Binding IsUnityPathValid, Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding UnityAssetsPath, UpdateSourceTrigger=PropertyChanged}" 
                                     ToolTip="Specify Unity Assets subfolder destination for UXML/USS artifacts"
                                     Style="{StaticResource ProMaxTextBoxStyle}"/>
                            <TextBlock Text="Assets/UI/Generated" 
                                       Foreground="#6E6E6E" 
                                       FontSize="12" FontFamily="Cascadia Code, Consolas" Margin="16,12" IsHitTestVisible="False"
                                       Visibility="{Binding UnityAssetsPath, Converter={StaticResource NullOrEmptyToVisConverter}}"/>
                        </Grid>

                        <Button Grid.Column="1" 
                                Command="{Binding BrowseFolderCommand}" 
                                Content="Browse..." 
                                ToolTip="Select local folder using Windows Folder Browser"
                                Style="{StaticResource ProMaxSecondaryButtonStyle}" 
                                Margin="12,0,0,0" Padding="20,0"/>
                    </Grid>
                </StackPanel>

                <!-- Action Button: Continue to Sync -->
                <Button Command="{Binding ContinueToSyncCommand}" 
                        Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                        ToolTip="Proceed to Screen 3 (Sync &amp; Live Terminal Logs)"
                        Padding="32,14" FontSize="14" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Continue to Sync  ➔" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
