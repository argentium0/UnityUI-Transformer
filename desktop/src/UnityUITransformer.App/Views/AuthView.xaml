<UserControl x:Class="UnityUITransformer.App.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <!-- Fluid Screen Loaded Storyboard: Smooth 0.4s Fade-In & Slide-Up from Y=20 -->
    <UserControl.RenderTransform>
        <TranslateTransform Y="20"/>
    </UserControl.RenderTransform>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Elevated Charcoal Card Panel (CornerRadius=24, Flat, No Shadow) -->
        <Border Background="#25262B" 
                CornerRadius="24" 
                Padding="40,36" MaxWidth="620">

            <StackPanel>
                <!-- Screen Header & Badge -->
                <Grid Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Background="#D4FF32" Margin="0,0,14,0">
                            <TextBlock Text="1" Foreground="#18181A" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Authentication" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20"/>
                            <TextBlock Text="Connect your Figma design environment" Foreground="#9E9E9E" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Authenticated Badge if connected -->
                    <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}" 
                            Background="#192A20" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="14,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="✓ Authenticated" Foreground="#10B981" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>

                <Separator Background="#2D2E34" Margin="0,0,0,24"/>

                <!-- Body Explanation -->
                <TextBlock Text="A valid Figma session is required to parse component hierarchies, layout flexboxes, and extract design tokens for Unity UI Toolkit." 
                           Foreground="#9E9E9E" FontSize="13.5" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,32"/>

                <!-- Main Action Button / Active State -->
                <Grid HorizontalAlignment="Left">
                    <!-- Disconnected State: Royal Blue Pill Button -->
                    <Button Command="{Binding ConnectCommand}" 
                            Style="{StaticResource ProMaxPrimaryButtonStyle}" 
                            ToolTip="Initiate secure OAuth 2.0 PKCE handshake with Figma"
                            Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"
                            Padding="32,14" FontSize="14">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsConnecting, Converter={StaticResource InverseBoolToVisConverter}}">
                                <!-- Official Figma Pure XAML Vector Logo (38x57 grid) -->
                                <Viewbox Width="15" Height="22.5" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Canvas Width="38" Height="57">
                                        <!-- Top-Left Shape: Orange-Red (#F24E1E) -->
                                        <Path Fill="#F24E1E" Data="M 9.5,0 H 19 V 19 H 9.5 C 4.253,19 0,14.747 0,9.5 C 0,4.253 4.253,0 9.5,0 Z"/>
                                        <!-- Top-Right Circle: Coral (#FF7262) -->
                                        <Path Fill="#FF7262" Data="M 28.5,0 C 33.747,0 38,4.253 38,9.5 C 38,14.747 33.747,19 28.5,19 C 23.253,19 19,14.747 19,9.5 C 19,4.253 23.253,0 28.5,0 Z"/>
                                        <!-- Middle-Left Shape: Purple (#A259FF) -->
                                        <Path Fill="#A259FF" Data="M 9.5,19 H 19 V 38 H 9.5 C 4.253,38 0,33.747 0,28.5 C 0,23.253 4.253,19 9.5,19 Z"/>
                                        <!-- Middle-Right Circle: Blue (#1ABCFE) -->
                                        <Path Fill="#1ABCFE" Data="M 28.5,19 C 33.747,19 38,23.253 38,28.5 C 38,33.747 33.747,38 28.5,38 C 23.253,38 19,33.747 19,28.5 C 19,23.253 23.253,19 28.5,19 Z"/>
                                        <!-- Bottom-Left Teardrop: Green (#0ACF83) -->
                                        <Path Fill="#0ACF83" Data="M 9.5,38 H 19 V 47.5 C 19,52.747 14.747,57 9.5,57 C 4.253,57 0,52.747 0,47.5 C 0,42.253 4.253,38 9.5,38 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Connect with Figma" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisConverter}}">
                                <Viewbox Width="15" Height="22.5" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.7">
                                    <Canvas Width="38" Height="57">
                                        <Path Fill="#F24E1E" Data="M 9.5,0 H 19 V 19 H 9.5 C 4.253,19 0,14.747 0,9.5 C 0,4.253 4.253,0 9.5,0 Z"/>
                                        <Path Fill="#FF7262" Data="M 28.5,0 C 33.747,0 38,4.253 38,9.5 C 38,14.747 33.747,19 28.5,19 C 23.253,19 19,14.747 19,9.5 C 19,4.253 23.253,0 28.5,0 Z"/>
                                        <Path Fill="#A259FF" Data="M 9.5,19 H 19 V 38 H 9.5 C 4.253,38 0,33.747 0,28.5 C 0,23.253 4.253,19 9.5,19 Z"/>
                                        <Path Fill="#1ABCFE" Data="M 28.5,19 C 33.747,19 38,23.253 38,28.5 C 38,33.747 33.747,38 28.5,38 C 23.253,38 19,33.747 19,28.5 C 19,23.253 23.253,19 28.5,19 Z"/>
                                        <Path Fill="#0ACF83" Data="M 9.5,38 H 19 V 47.5 C 19,52.747 14.747,57 9.5,57 C 4.253,57 0,52.747 0,47.5 C 0,42.253 4.253,38 9.5,38 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Connecting to Figma..." FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Connected State: Session Active Badge -->
                    <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"
                            Background="#1F2024" BorderBrush="#10B981" BorderThickness="1" CornerRadius="14" Padding="22,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓ Active Token:" Foreground="#9E9E9E" FontWeight="Medium" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ConnectedUser}" Foreground="#10B981" FontWeight="Bold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
